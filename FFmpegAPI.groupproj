    <Target Name="FFmpegAPI">
        <MSBuild Projects="packages\FFmpegAPI.dproj"/>
    </Target>
    <Target Name="FFmpegAPI:Clean">
        <MSBuild Projects="packages\FFmpegAPI.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FFmpegAPI:Make">
        <MSBuild Projects="packages\FFmpegAPI.dproj" Targets="Make"/>
    </Target>
    <Target Name="FFmpegAPIFMX">
