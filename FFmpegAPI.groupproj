    </Target>
    <Target Name="FFmpegAPIFMX:Clean">
        <MSBuild Projects="packages\FFmpegAPIFMX.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FFmpegAPIFMX:Make">
        <MSBuild Projects="packages\FFmpegAPIFMX.dproj" Targets="Make"/>
